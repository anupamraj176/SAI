# ================================================================
# RENDER DEPLOYMENT ENVIRONMENT VARIABLES (BACKEND)
# Add these in the Render Dashboard under: Environment -> Environment Variables
# ================================================================

# Server Config
PORT=5001
NODE_ENV=production
BACKEND_URL=https://sai-backend-3upn.onrender.com

# Frontend Origin URL (Vercel URL)
CLIENT_URL=https://farmerhub-henna.vercel.app
CORS_ORIGINS=https://farmerhub-henna.vercel.app,http://localhost:5173

# Database Connection (MongoDB Atlas)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/SAI?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Cloudinary Storage Config
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Email Services (Nodemailer / Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
SUPPORT_EMAIL=support@example.com

# AI Integration
GEMINI_API_KEY=your_gemini_api_key

# Payment Providers
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
