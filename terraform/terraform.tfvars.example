# Copy this file to terraform.tfvars (ignored by Git) before running terraform apply
aws_region       = "ap-south-1"
instance_type    = "t3.micro"
ssh_allowed_cidr = "0.0.0.0/0" # Recommended: replace with "YOUR_IP/32"

# Option A: Paste your SSH public key (~/.ssh/id_ed25519.pub) to create an EC2 key pair automatically
# ssh_public_key = "ssh-ed25519 AAAA... your-email@example.com"

# Option B: Or reference an existing EC2 Key Pair name created in the AWS Console
# existing_key_name = "my-aws-keypair"

create_eip       = false
s3_force_destroy = false

